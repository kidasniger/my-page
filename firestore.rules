rules_version = '2';

// My Page : chaque utilisateur n'accède qu'à ses propres données.
// Le bot (compte de service) ignore ces règles et écrit le reste.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Seuls ces champs ont changé entre l'ancien et le nouveau document.
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function pageSizesOk() {
      let d = request.resource.data;
      return d.get('nom', '') is string
        && d.get('nom', '').size() <= 200
        && d.get('tokenEnc', '') is string
        && d.get('tokenEnc', '').size() <= 8192
        && d.get('demande', 'connecter') in ['connecter', 'deconnecter']
        && (d.get('demande', '') != 'deconnecter' || !('tokenEnc' in d));
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);

      // Pages connectées : le client ne touche ni status ni quotas.
      match /pages/{pageId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['nom', 'tokenEnc', 'demande', 'maj'])
          && request.resource.data.get('maj', request.time) == request.time
          && pageSizesOk();
        allow update: if isOwner(uid)
          && onlyChanges(['nom', 'tokenEnc', 'demande', 'maj'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['maj'])
            || request.resource.data.maj == request.time)
          && pageSizesOk();
      }

      // Boîte : écrite par le bot, le client marque seulement « traite ».
      match /inbox/{id} {
        allow read, delete: if isOwner(uid);
        allow update: if isOwner(uid)
          && onlyChanges(['traite'])
          && request.resource.data.traite is bool;
      }

      // Statistiques : écrites par le bot.
      match /stats/{id} {
        allow read, delete: if isOwner(uid);
      }

      // Quota IA : lecture seule, jamais supprimable par le client.
      match /quota/{id} {
        allow read: if isOwner(uid);
      }

      // Profil de la Page : le client écrit ses réponses (champs connus seulement).
      match /profil/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['activite', 'ton', 'langues', 'public',
               'offres', 'horaires', 'faq', 'eviter', 'motsInterdits', 'silence',
               'reponsesAuto', 'reponsePrix', 'sujets', 'completion', 'maj', 'dryRun',
               'nom', 'description', 'reponses', 'moderation'])
          && request.resource.data.get('maj', request.time) == request.time;
      }

      // Proposition de profil : écrite par le bot ; le client note ses décisions
      // et peut redemander une analyse, sans toucher aux valeurs proposées.
      match /proposition/{id} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['etat'])
          && request.resource.data.etat == 'redemande';
        allow update: if isOwner(uid)
          && onlyChanges(['decisions', 'etat'])
          && request.resource.data.get('etat', 'redemande') is string
          && (request.resource.data.get('etat', '') == resource.data.get('etat', '')
            || request.resource.data.etat == 'redemande')
          && request.resource.data.get('decisions', {}) is map
          && request.resource.data.get('decisions', {}).size() <= 10;
      }

      // Questions : créées par le bot, le client écrit réponse et état.
      match /questions/{id} {
        allow read, delete: if isOwner(uid);
        allow update: if isOwner(uid)
          && onlyChanges(['reponse', 'etat', 'reponduLe'])
          && request.resource.data.get('reponse', '') is string
          && request.resource.data.get('reponse', '').size() <= 2000
          && request.resource.data.get('etat', '') in ['repondue', 'passee']
          && request.resource.data.get('reponduLe', request.time) == request.time;
      }

      // File d'actions pour le bot : création et suppression seulement.
      match /file/{id} {
        allow read, create, delete: if isOwner(uid);
      }
    }

    // Tout le reste est refusé.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
